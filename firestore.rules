rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net (Default Deny Catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') == 'admin')
      );
    }

    // 2. Users Profile Collection Rules (Protected against VIP / isPro spoofing)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // On creation, users cannot self-grant VIP (isPro) or admin role
      allow create: if isOwner(userId) 
        && request.resource.data.get('isPro', false) == false
        && request.resource.data.get('role', 'student') == 'student';
        
      // On update, users CANNOT elevate their own isPro, role, or subscriptionExpiresAt
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPro', 'role', 'subscriptionExpiresAt'])
        || isAdmin()
      );
      
      // On delete, user can purge their account (COPPA/GDPR compliance)
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Allocated Emails (For welcome bonus tracking, write once, immutable)
    match /allocated_emails/{email} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 4. Pocket Items Collection Rules
    match /pocket_items/{itemId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 5. AI Tutor Chats Collection Rules
    match /ai_tutor_chats/{chatId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 6. Quiz Results Collection Rules
    match /quiz_results/{resultId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 7. Mistake Vault Collection Rules
    match /MistakeVault/{mistakeId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 8. Generated Questions Collection Rules
    match /generated_questions/{questionId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 9. PDF History Collection Rules
    match /pdf_history/{pdfId} {
      allow read, write: if isSignedIn() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 10. AP Sample Papers Collection Rules (Publicly readable, write/delete strictly restricted to Admin)
    match /ap_sample_papers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. AP Unit Sample Papers (Uploaded via Developer Portal, readable by all student users)
    match /ap_unit_sample_papers/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /ap_unit_sample_paper_chunks/{chunkId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
